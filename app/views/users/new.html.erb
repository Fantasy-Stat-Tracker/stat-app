<section class="mx-auto max-w-xl rounded-lg border border-gray-200 bg-white p-8 font-[Arial,sans-serif] shadow-sm">
  <h1 class="text-3xl font-bold">Create your account</h1>
  <p class="mt-2 text-gray-600">Start with an email and password. You’ll be able to add leagues in the future.</p>

  <% if @user.errors.any? %>
    <div class="mt-6 rounded border border-red-300 bg-red-50 px-4 py-3 text-red-900" role="alert">
      <p class="font-semibold">Please fix the following:</p>
      <ul class="mt-2 list-disc pl-5">
        <% @user.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%= form_with model: @user, url: signup_path, class: "mt-6 space-y-5" do |form| %>
    <div>
      <%= form.label :email, class: "block font-semibold" %>
      <%= form.email_field :email, required: true, autocomplete: "email", autofocus: true, class: "mt-1 w-full rounded border border-gray-300 px-3 py-2 focus:border-blue-500 focus:outline-none" %>
    </div>

    <div>
      <%= form.label :password, class: "block font-semibold" %>
      <%= form.password_field :password, required: true, minlength: 8, autocomplete: "new-password", class: "mt-1 w-full rounded border border-gray-300 px-3 py-2 focus:border-blue-500 focus:outline-none" %>
      <p class="mt-1 text-sm text-gray-500">Use at least 8 characters.</p>
    </div>

    <%= form.submit "Create account", class: "w-full cursor-pointer rounded border-b-4 border-gray-700 bg-gray-500 px-4 py-2 font-bold text-white hover:border-gray-500 hover:bg-gray-400" %>
  <% end %>

  <p class="mt-6 text-center text-sm text-gray-600">Already have an account? <label for="login-modal" class="cursor-pointer underline text-blue-700">Log in.</label></p>
</section>
