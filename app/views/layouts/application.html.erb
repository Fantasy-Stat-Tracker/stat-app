<!DOCTYPE html>
<html>
  <head>
    <title>Chumpions Club</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= favicon_link_tag asset_path('football-24.png') %>
    <%= javascript_include_tag 'application', 'data-turbo-track': 'reload' %>
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
  </head>

  <body class="bg-gradient-to-r from-gray-50 via-gray-50 to-blue-100 text-black pb-10">
    <%= render partial: "shared/navbar" %>
    <main class="mx-auto mt-12 px-5">
        <%= yield %>
    </main>
  </body>
</html>
