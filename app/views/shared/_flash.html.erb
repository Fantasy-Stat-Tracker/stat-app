<% flash.each do |type, message| %>
  <% color_classes = type.to_s == "danger" ? "border-red-300 bg-red-50 text-red-900" : "border-blue-300 bg-blue-50 text-blue-900" %>
  <div role="status" class="mx-auto mt-4 max-w-2xl rounded border px-4 py-3 <%= color_classes %>">
    <%= message %>
  </div>
<% end %>
