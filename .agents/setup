#!/usr/bin/env bash
set -euo pipefail

step() {
  printf '\n==> %s\n' "$1"
}

step "Installing system dependencies"
packages=(
  build-essential
  curl
  libffi-dev
  libgmp-dev
  libpq-dev
  libreadline-dev
  libssl-dev
  libyaml-dev
  postgresql
  postgresql-contrib
  redis-server
  zlib1g-dev
)
missing_packages=()
for package in "${packages[@]}"; do
  if ! dpkg-query -W -f='${Status}' "$package" 2>/dev/null | grep -Fq "install ok installed"; then
    missing_packages+=("$package")
  fi
done
if ((${#missing_packages[@]})); then
  sudo apt-get update
  sudo DEBIAN_FRONTEND=noninteractive apt-get install -y "${missing_packages[@]}"
fi

step "Installing the pinned Ruby toolchain"
if [[ ! -x "$HOME/.local/bin/mise" ]]; then
  curl -fsSL https://mise.run | sh
fi
export PATH="$HOME/.local/bin:$HOME/.local/share/mise/shims:$PATH"
mise install

profile_marker="# stat-app mise toolchain"
if ! grep -Fqx "$profile_marker" "$HOME/.bash_profile" 2>/dev/null; then
  cat >> "$HOME/.bash_profile" <<'EOF'

# stat-app mise toolchain
export PATH="$HOME/.local/bin:$HOME/.local/share/mise/shims:$PATH"
EOF
fi

step "Installing Ruby dependencies"
bundler_version="$(awk '/^BUNDLED WITH$/{getline; gsub(/^[[:space:]]+/, ""); print; exit}' Gemfile.lock)"
if ! gem list --installed --exact bundler --version "$bundler_version" >/dev/null; then
  gem install bundler --version "$bundler_version" --no-document
fi
if ! bundle _"$bundler_version"_ check; then
  bundle _"$bundler_version"_ install --jobs "$(nproc)" --retry 3
fi

step "Installing JavaScript dependencies"
yarn install --frozen-lockfile --non-interactive

step "Starting backing services"
sudo service postgresql start
sudo service redis-server start

if ! sudo -u postgres psql -tAc "SELECT 1 FROM pg_roles WHERE rolname = '$USER'" | grep -Fqx 1; then
  sudo -u postgres createuser --superuser "$USER"
fi

step "Preparing development and test databases"
bin/rails db:prepare
RAILS_ENV=test bin/rails db:prepare

step "Clearing stale temporary files"
bin/rails log:clear tmp:clear

printf '\nOrb setup complete.\n'
